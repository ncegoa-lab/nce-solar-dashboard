# Dashboard login
NCE_APP_USER=admin
NCE_APP_PASSWORD=change-this-password
NCE_SESSION_SECRET=use-a-long-random-secret

# Optional advanced user list for customer-only access.
# Prefer setting this as a cloud secret, not committing it to Git.
# NCE_USERS_JSON={"users":[{"username":"customer1","password_hash":"pbkdf2_sha256$...","role":"customer","plants":["Solis::ELVIS GOMES"]}]}

# Cloud output folder
SOLAR_OUTPUT_DIR=/app/reports
SOLAR_AUTO_REFRESH_ON_OPEN=false

# Inverter portal credentials. Set only the brands you want refreshed online.
SEMS_USERNAME=
SEMS_PASSWORD=
FRONIUS_USERNAME=
FRONIUS_PASSWORD=
FIMER_USERNAME=
FIMER_PASSWORD=
SOLAX_USERNAME=
SOLAX_PASSWORD=

# SolisCloud currently uses captured/imported data because browser login may require CAPTCHA.
SOLIS_USERNAME=
SOLIS_PASSWORD=
